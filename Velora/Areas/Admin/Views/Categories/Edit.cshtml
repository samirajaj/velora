@model AdminCategoryModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Edit Category" : "New Category"; }
<section class="admin-page shell-narrow"><header class="admin-heading"><div><p class="eyebrow">Catalog management</p><h1>@ViewData["Title"]</h1></div><a class="text-link" asp-action="Index">Back</a></header>@if (TempData["AdminMessage"] is string message) { <div class="admin-notice">@message</div> }<form class="admin-form" asp-action="Save" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="admin-panel"><div class="field"><label asp-for="Name"></label><input asp-for="Name" maxlength="100" /><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Slug">SEO slug <small>Generated automatically when blank</small></label><input asp-for="Slug" /></div><div class="field"><label asp-for="Description"></label><textarea asp-for="Description" rows="5"></textarea></div><div class="field"><label asp-for="DisplayOrder">Display order</label><input asp-for="DisplayOrder" type="number" min="0" /></div><div class="field"><label asp-for="SeoTitle">SEO title</label><input asp-for="SeoTitle" maxlength="160" /></div><div class="field"><label asp-for="SeoDescription">SEO description</label><textarea asp-for="SeoDescription" maxlength="320" rows="3"></textarea></div><label class="check-field"><input asp-for="IsActive" /> Visible in storefront</label><button class="button button-dark" type="submit">Save category</button></div></form></section>
