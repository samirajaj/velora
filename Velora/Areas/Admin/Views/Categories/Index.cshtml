@model IReadOnlyList<AdminCategoryListItem>
@{ ViewData["Title"] = "Categories"; }
<section class="admin-page shell"><header class="admin-heading"><div><p class="eyebrow">Catalog management</p><h1>Categories</h1></div><a class="button button-dark" asp-action="Create">New category</a></header>@if (TempData["AdminMessage"] is string message) { <div class="admin-notice">@message</div> }<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Category</th><th>Products</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Name</strong><br /><small>/@item.Slug</small></td><td>@item.ProductCount</td><td><span class="status-pill @(item.IsActive && !item.IsArchived ? "active" : "")">@(item.IsArchived ? "Archived" : item.IsActive ? "Live" : "Hidden")</span></td><td><div class="table-actions"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Archive" method="post" data-confirm="@(item.IsArchived ? "Restore this category?" : "Archive this category?")"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="archived" value="@(!item.IsArchived)" /><button type="submit">@(item.IsArchived ? "Restore" : "Archive")</button></form></div></td></tr> }</tbody></table></div></section>
