@model AdminDashboardStats
@{ ViewData["Title"] = "Admin Dashboard"; }
<section class="admin-page shell"><header><p class="eyebrow">Velora administration</p><h1>Dashboard</h1><p>A live view of your store.</p></header><div class="stat-grid"><div><strong>@Model.ActiveProducts</strong><span>Active products</span></div><div class="@(Model.LowStockVariants > 0 ? "alert" : "")"><strong>@Model.LowStockVariants</strong><span>Low-stock variants</span></div><div><strong>@Model.Customers</strong><span>Customers</span></div><div><strong>@Model.OpenOrders</strong><span>Open orders</span></div><div><strong>$@Model.Revenue.ToString("N0")</strong><span>Gross order value</span></div></div><div class="admin-grid"><a asp-controller="Products" asp-action="Index"><span>01</span><h2>Catalog</h2><p>Products, variants, inventory, and imagery.</p></a><a asp-controller="Orders" asp-action="Index"><span>02</span><h2>Orders</h2><p>Cash collection, fulfillment, and delivery.</p></a><a asp-controller="Categories" asp-action="Index"><span>03</span><h2>Categories</h2><p>Organize storefront navigation.</p></a><a asp-controller="Collections" asp-action="Index"><span>04</span><h2>Collections</h2><p>Build featured merchandising stories.</p></a><a asp-controller="Coupons" asp-action="Index"><span>05</span><h2>Coupons</h2><p>Promotions and discount limits.</p></a><a asp-controller="Users" asp-action="Index"><span>06</span><h2>Customers</h2><p>Access and role management.</p></a><a asp-controller="Audit" asp-action="Index"><span>07</span><h2>Audit</h2><p>Review administrative changes.</p></a></div><div class="admin-panel dashboard-orders"><h2>Recent orders</h2><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Total</th></tr></thead><tbody>@foreach (var order in Model.RecentOrders) { <tr><td><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">@order.Number</a></td><td>@order.CustomerEmail</td><td>@order.Status</td><td>$@order.Total.ToString("N2")</td></tr> }</tbody></table></div></div></section>
