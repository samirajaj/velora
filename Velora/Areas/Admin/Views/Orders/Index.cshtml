@model IReadOnlyList<AdminOrderListItem>
@{ ViewData["Title"] = "Orders"; }
<section class="admin-page shell"><header><p class="eyebrow">Fulfillment</p><h1>Orders</h1></header><form class="admin-filters"><select name="status"><option value="">All statuses</option>@foreach (var status in new[] { "Pending", "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled" }) { <option value="@status">@status</option> }</select><button class="button button-dark">Filter</button></form><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Items</th><th>Status</th><th>Total</th></tr></thead><tbody>@foreach (var order in Model) { <tr><td><a asp-action="Details" asp-route-id="@order.Id">@order.Number</a></td><td>@order.CustomerEmail</td><td>@order.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")</td><td>@order.ItemCount</td><td>@order.Status</td><td>@order.Total.ToString("N2") @order.Currency</td></tr> }</tbody></table></div></section>
