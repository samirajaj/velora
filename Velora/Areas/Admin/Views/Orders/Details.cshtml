@model AdminOrderDetails
@{ ViewData["Title"] = Model.Number; }
<section class="admin-page shell"><header class="admin-heading"><div><p class="eyebrow">Order management</p><h1>@Model.Number</h1><p>@Model.CreatedAtUtc.ToString("f") · @Model.CustomerEmail</p></div><a class="text-link" asp-action="Index">Back to orders</a></header>@if (TempData["AdminMessage"] is string message) { <div class="admin-notice">@message</div> }<div class="admin-form-grid"><div><div class="admin-panel"><h2>Items</h2><table class="admin-table"><thead><tr><th>Product</th><th>SKU</th><th>Qty</th><th>Total</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.ProductName<br /><small>@item.Option</small></td><td>@item.Sku</td><td>@item.Quantity</td><td>$@item.LineTotal.ToString("N2")</td></tr> }</tbody></table></div><div class="admin-panel"><h2>History</h2>@foreach (var history in Model.History) { <p>@history</p> }</div></div><aside><div class="admin-panel"><h2>Summary</h2><p><strong>@Model.Total.ToString("N2") @Model.Currency</strong></p><p>Payment: @Model.PaymentStatus<br />Shipment: @Model.ShipmentStatus</p><p>@Model.RecipientName<br />@Model.Phone<br />@Model.Address</p></div><form class="admin-panel" asp-action="Update" method="post"><input type="hidden" name="id" value="@Model.Id" /><h2>Update status</h2><div class="field"><label>Order status</label><select name="status">@foreach (var status in new[] { "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled" }) { <option value="@status" selected="@(Model.Status == status)">@status</option> }</select></div><div class="field"><label>Shipment status</label><select name="shipmentStatus">@foreach (var status in new[] { "Pending", "Preparing", "Shipped", "Delivered", "Returned" }) { <option value="@status" selected="@(Model.ShipmentStatus == status)">@status</option> }</select></div><div class="field"><label>Internal note</label><textarea name="note"></textarea></div><button class="button button-dark">Update order</button></form></aside></div></section>
