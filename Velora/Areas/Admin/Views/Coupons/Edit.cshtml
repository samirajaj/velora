@model AdminCouponModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Edit Coupon" : "New Coupon"; }
<section class="admin-page shell-narrow"><header><p class="eyebrow">Merchandising</p><h1>@ViewData["Title"]</h1></header><form class="admin-panel" asp-action="Save" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly"></div><div class="field"><label>Code</label><input asp-for="Code" /></div><div class="form-row"><div class="field"><label>Type</label><select asp-for="Type"><option>Percentage</option><option>FixedAmount</option></select></div><div class="field"><label>Value</label><input asp-for="Value" type="number" min="0.01" step="0.01" /></div></div><div class="form-row"><div class="field"><label>Minimum order</label><input asp-for="MinimumOrderAmount" type="number" min="0" step="0.01" /></div><div class="field"><label>Usage limit</label><input asp-for="UsageLimit" type="number" min="1" /></div></div><div class="form-row"><div class="field"><label>Starts</label><input asp-for="StartsAtUtc" type="datetime-local" /></div><div class="field"><label>Ends</label><input asp-for="EndsAtUtc" type="datetime-local" /></div></div><label class="check-field"><input asp-for="IsActive" /> Active</label><button class="button button-dark">Save coupon</button></form></section>
