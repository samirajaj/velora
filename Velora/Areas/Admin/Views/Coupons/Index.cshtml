@model IReadOnlyList<AdminCouponModel>
@{ ViewData["Title"] = "Coupons"; }
<section class="admin-page shell"><header class="admin-heading"><div><p class="eyebrow">Merchandising</p><h1>Coupons</h1></div><a class="button button-dark" asp-action="Create">New coupon</a></header><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Code</th><th>Discount</th><th>Window</th><th>Usage</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Code</strong></td><td>@item.Value @(item.Type == "Percentage" ? "%" : "USD")</td><td>@item.StartsAtUtc.ToString("dd MMM") – @(item.EndsAtUtc?.ToString("dd MMM") ?? "Open")</td><td>@item.UsageCount / @(item.UsageLimit?.ToString() ?? "∞")</td><td>@(item.IsActive ? "Active" : "Disabled")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a></td></tr> }</tbody></table></div></section>
