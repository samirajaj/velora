@model AdminCollectionModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Edit Collection" : "New Collection"; }
<section class="admin-page shell"><header class="admin-heading"><div><p class="eyebrow">Merchandising</p><h1>@ViewData["Title"]</h1></div><a class="text-link" asp-action="Index">Back</a></header><form class="admin-panel" asp-action="Save" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Name"></label><input asp-for="Name" maxlength="120" /></div><div class="field"><label asp-for="Slug">SEO slug</label><input asp-for="Slug" /></div><div class="field"><label asp-for="Description"></label><textarea asp-for="Description" rows="5"></textarea></div><div class="field"><label asp-for="PublishAtUtc">Publish at</label><input asp-for="PublishAtUtc" type="datetime-local" /></div><label class="check-field"><input asp-for="IsFeatured" /> Featured collection</label><button class="button button-dark" type="submit">Save collection</button></form></section>
