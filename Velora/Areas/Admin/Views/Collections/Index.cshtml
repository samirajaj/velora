@model IReadOnlyList<AdminCollectionListItem>
@{ ViewData["Title"] = "Collections"; }
<section class="admin-page shell"><header class="admin-heading"><div><p class="eyebrow">Merchandising</p><h1>Collections</h1></div><a class="button button-dark" asp-action="Create">New collection</a></header><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Name</th><th>Products</th><th>Publication</th><th>State</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Name</strong><small>/@item.Slug</small></td><td>@item.ProductCount</td><td>@(item.PublishAtUtc?.ToString("dd MMM yyyy HH:mm") ?? "Immediate")</td><td>@(item.IsArchived ? "Archived" : item.IsFeatured ? "Featured" : "Active")</td><td class="table-actions"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Archive" method="post" data-confirm="@(item.IsArchived ? "Restore this collection?" : "Archive this collection?")"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="archived" value="@(!item.IsArchived)" /><button type="submit">@(item.IsArchived ? "Restore" : "Archive")</button></form></td></tr> }</tbody></table></div></section>
