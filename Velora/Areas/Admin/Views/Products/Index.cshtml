@model IReadOnlyList<AdminProductListItem>
@{ ViewData["Title"] = "Products"; }
<section class="admin-page shell"><header class="admin-heading"><div><p class="eyebrow">Catalog management</p><h1>Products</h1><p>@Model.Count products shown</p></div><a class="button button-dark" asp-action="Create">New product</a></header>
@if (TempData["AdminMessage"] is string message) { <div class="admin-notice">@message</div> }
<form class="admin-filters" method="get"><input type="search" name="search" value="@Context.Request.Query["search"]" placeholder="Search products" /><label><input type="checkbox" name="includeArchived" value="true" checked="@(Context.Request.Query["includeArchived"] == "true")" /> Include archived</label><button class="button button-dark" type="submit">Filter</button></form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><div class="admin-product-cell"><img src="@item.ImageUrl" alt="" /><div><strong>@item.Name</strong><small>/@item.Slug</small></div></div></td><td>@item.Category</td><td>$@item.Price.ToString("N2")</td><td class="@(item.Stock <= 5 ? "low-stock" : "")">@item.Stock</td><td>@if (item.IsArchived) { <span class="status-pill">Archived</span> } else if (item.IsActive) { <span class="status-pill active">Live</span> } else { <span class="status-pill">Draft</span> } @if (item.IsFeatured) { <span class="status-pill featured">Featured</span> }</td><td><div class="table-actions"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Feature" method="post"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="featured" value="@(!item.IsFeatured)" /><button type="submit">@(item.IsFeatured ? "Unfeature" : "Feature")</button></form><form asp-action="Archive" method="post" data-confirm="@(item.IsArchived ? "Restore this product?" : "Archive this product? It will disappear from the storefront.")"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="archived" value="@(!item.IsArchived)" /><button type="submit">@(item.IsArchived ? "Restore" : "Archive")</button></form></div></td></tr> }</tbody></table></div></section>
