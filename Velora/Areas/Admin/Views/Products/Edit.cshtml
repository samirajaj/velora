@model AdminProductModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Edit Product" : "New Product"; }
<section class="admin-page shell"><header class="admin-heading"><div><p class="eyebrow">Catalog management</p><h1>@ViewData["Title"]</h1></div><a class="text-link" asp-action="Index">Back to products</a></header>
@if (TempData["AdminMessage"] is string message) { <div class="admin-notice">@message</div> } @if (TempData["AdminError"] is string error) { <div class="admin-notice error">@error</div> }
<form class="admin-form" asp-action="Save" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="admin-form-grid"><div class="admin-form-main"><div class="admin-panel"><h2>Product information</h2><div class="field"><label asp-for="Name"></label><input asp-for="Name" maxlength="200" /><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Slug">SEO slug <small>Leave blank to generate automatically</small></label><input asp-for="Slug" /></div><div class="field"><label asp-for="Description"></label><textarea asp-for="Description" rows="7"></textarea></div><div class="form-row"><div class="field"><label asp-for="Material"></label><input asp-for="Material" /></div><div class="field"><label asp-for="CareInstructions">Care instructions</label><input asp-for="CareInstructions" /></div></div></div>
<div class="admin-panel"><div class="panel-heading"><h2>Variants and inventory</h2><button type="button" class="text-button" data-add-variant>Add variant</button></div><div class="variant-list" data-variant-list>@for (var i = 0; i < Model.Variants.Count; i++) { <div class="variant-row"><input asp-for="Variants[i].Id" type="hidden" /><div class="field"><label>SKU</label><input asp-for="Variants[i].Sku" /></div><div class="field"><label>Color</label><input asp-for="Variants[i].Color" /></div><div class="field compact"><label>Hex</label><input asp-for="Variants[i].ColorHex" type="color" /></div><div class="field compact"><label>Size</label><input asp-for="Variants[i].Size" /></div><div class="field compact"><label>Stock</label><input asp-for="Variants[i].StockQuantity" type="number" min="0" /></div><div class="field compact"><label>Low at</label><input asp-for="Variants[i].LowStockThreshold" type="number" min="0" /></div><label class="check-field"><input asp-for="Variants[i].IsActive" /> Active</label><button type="button" class="remove-variant" data-remove-variant aria-label="Remove variant">×</button></div> }</div><template data-variant-template><div class="variant-row"><div class="field"><label>SKU</label><input name="Variants[__INDEX__].Sku" /></div><div class="field"><label>Color</label><input name="Variants[__INDEX__].Color" /></div><div class="field compact"><label>Hex</label><input name="Variants[__INDEX__].ColorHex" type="color" value="#000000" /></div><div class="field compact"><label>Size</label><input name="Variants[__INDEX__].Size" /></div><div class="field compact"><label>Stock</label><input name="Variants[__INDEX__].StockQuantity" type="number" min="0" value="0" /></div><div class="field compact"><label>Low at</label><input name="Variants[__INDEX__].LowStockThreshold" type="number" min="0" value="5" /></div><label class="check-field"><input name="Variants[__INDEX__].IsActive" type="checkbox" value="true" checked /> Active</label><button type="button" class="remove-variant" data-remove-variant>×</button></div></template></div>
<div class="admin-panel"><h2>SEO</h2><div class="field"><label asp-for="SeoTitle">SEO title</label><input asp-for="SeoTitle" maxlength="160" /></div><div class="field"><label asp-for="SeoDescription">SEO description</label><textarea asp-for="SeoDescription" maxlength="320" rows="3"></textarea></div></div></div>
<aside><div class="admin-panel"><h2>Publishing</h2><div class="field"><label asp-for="CategoryId">Category</label><select asp-for="CategoryId"><option value="">Choose category</option>@foreach (var option in Model.Categories) { <option value="@option.Id">@option.Name</option> }</select><span asp-validation-for="CategoryId"></span></div><div class="field"><label asp-for="CollectionId">Collection</label><select asp-for="CollectionId"><option value="">No collection</option>@foreach (var option in Model.Collections) { <option value="@option.Id">@option.Name</option> }</select></div><div class="field"><label asp-for="PublishAtUtc">Publish at</label><input asp-for="PublishAtUtc" type="datetime-local" /></div><label class="check-field"><input asp-for="IsActive" /> Published</label><label class="check-field"><input asp-for="IsFeatured" /> Featured</label></div><div class="admin-panel"><h2>Pricing & shipping</h2><div class="field"><label asp-for="Price"></label><input asp-for="Price" type="number" min="0.01" step="0.01" /></div><div class="field"><label asp-for="CompareAtPrice">Compare-at price</label><input asp-for="CompareAtPrice" type="number" min="0" step="0.01" /></div><div class="field"><label asp-for="WeightGrams">Weight (grams)</label><input asp-for="WeightGrams" type="number" min="0" /></div><div class="form-row"><div class="field"><label asp-for="ShippingLengthCm">Length cm</label><input asp-for="ShippingLengthCm" type="number" min="0" step="0.1" /></div><div class="field"><label asp-for="ShippingWidthCm">Width cm</label><input asp-for="ShippingWidthCm" type="number" min="0" step="0.1" /></div></div><div class="field"><label asp-for="ShippingHeightCm">Height cm</label><input asp-for="ShippingHeightCm" type="number" min="0" step="0.1" /></div></div><button class="button button-dark admin-save" type="submit">Save product</button></aside></div></form>
@if (Model.Id.HasValue) { <div class="admin-panel image-manager"><div class="panel-heading"><div><h2>Product images</h2><p>Drag to reorder. Select a primary image for the storefront.</p></div></div><form class="upload-form" asp-action="UploadImages" method="post" enctype="multipart/form-data"><input type="hidden" name="productId" value="@Model.Id" /><input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple required /><select name="variantId"><option value="">All variants</option>@foreach (var variant in Model.Variants.Where(x => x.Id.HasValue)) { <option value="@variant.Id">@variant.Sku</option> }</select><button class="button button-dark" type="submit">Upload images</button></form><form asp-action="ReorderImages" method="post"><input type="hidden" name="productId" value="@Model.Id" /><div class="image-admin-grid" data-sortable-images>@foreach (var image in Model.Images) { <article class="image-admin-card" draggable="true"><input type="hidden" name="imageIds" value="@image.Id" /><img src="@image.Url" alt="@image.AltText" /><span>@(image.IsPrimary ? "Primary" : $"Position {image.DisplayOrder + 1}")</span><div><button formaction="@Url.Action("PrimaryImage")" name="imageId" value="@image.Id" type="submit">Make primary</button><button formaction="@Url.Action("DeleteImage")" name="imageId" value="@image.Id" type="submit" data-confirm="Delete this image from the product and Cloudinary?">Delete</button></div></article> }</div>@if (Model.Images.Count > 1) { <button class="button button-dark" type="submit">Save image order</button> }</form></div> }
</section>
