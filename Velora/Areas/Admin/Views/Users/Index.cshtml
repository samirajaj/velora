@model IReadOnlyList<ApplicationUser>
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@{ ViewData["Title"] = "Customer Management"; }
@if (TempData["AdminError"] is string error) { <div class="admin-notice error shell" role="alert">@error</div> }
<section class="admin-page shell"><header><p class="eyebrow">Administration</p><h1>Users</h1><p>@Model.Count registered accounts</p></header><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Name</th><th>Email</th><th>Joined</th><th>Status</th><th>Role</th><th>Actions</th></tr></thead><tbody>@foreach (var user in Model) { var isAdmin = await UserManager.IsInRoleAsync(user, AppRoles.Admin); <tr><td>@user.DisplayName</td><td>@user.Email</td><td>@user.CreatedAtUtc.ToString("dd MMM yyyy")</td><td><span class="status-pill @(user.IsActive ? "active" : "")">@(user.IsActive ? "Active" : "Inactive")</span></td><td><form asp-action="Role" method="post"><input type="hidden" name="id" value="@user.Id" /><select name="role" onchange="this.form.submit()"><option value="Customer" selected="@(!isAdmin)">Customer</option><option value="Admin" selected="@isAdmin">Admin</option></select></form></td><td><form asp-action="Active" method="post" data-confirm="@(user.IsActive ? "Deactivate this account and invalidate its sessions?" : "Reactivate this account?")"><input type="hidden" name="id" value="@user.Id" /><input type="hidden" name="active" value="@(!user.IsActive)" /><button class="text-button">@(user.IsActive ? "Deactivate" : "Activate")</button></form></td></tr> }</tbody></table></div></section>
