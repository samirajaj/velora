@model IReadOnlyList<ApplicationUser>
@{ ViewData["Title"] = "Customer Management"; }
<section class="admin-page shell"><header><p class="eyebrow">Administration</p><h1>Users</h1><p>@Model.Count registered accounts</p></header><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Name</th><th>Email</th><th>Joined</th><th>Status</th></tr></thead><tbody>@foreach (var user in Model) { <tr><td>@user.DisplayName</td><td>@user.Email</td><td>@user.CreatedAtUtc.ToString("dd MMM yyyy")</td><td><span class="status-pill @(user.IsActive ? "active" : "")">@(user.IsActive ? "Active" : "Inactive")</span></td></tr> }</tbody></table></div></section>
