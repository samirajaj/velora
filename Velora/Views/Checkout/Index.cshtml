@model Velora.Features.Checkout.CheckoutFormViewModel
@{ ViewData["Title"] = "Checkout"; }
<section class="checkout-page shell"><header><p class="eyebrow">Secure checkout</p><h1>Delivery details</h1><p>Payment will be collected in cash when your order arrives.</p></header><form asp-action="Place" method="post"><div class="checkout-grid"><div class="checkout-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="admin-panel"><h2>Contact</h2><div class="field"><label>Email</label><input asp-for="CustomerEmail" type="email" /></div><div class="form-row"><div class="field"><label>Recipient name</label><input asp-for="RecipientName" /></div><div class="field"><label>Phone</label><input asp-for="PhoneNumber" /></div></div></div><div class="admin-panel"><h2>Delivery address</h2><div class="field"><label>Address line 1</label><input asp-for="AddressLine1" /></div><div class="field"><label>Address line 2</label><input asp-for="AddressLine2" /></div><div class="form-row"><div class="field"><label>City</label><input asp-for="City" /></div><div class="field"><label>Province</label><input asp-for="StateOrProvince" /></div></div><div class="form-row"><div class="field"><label>Postal code</label><input asp-for="PostalCode" /></div><div class="field"><label>Country code</label><input asp-for="CountryCode" maxlength="2" /></div></div><div class="field"><label>Delivery note</label><textarea asp-for="CustomerNote" rows="3"></textarea></div></div></div><aside class="cart-summary checkout-summary"><h2>Your order</h2>@foreach (var item in Model.Cart.Items) { <div><span>@item.Name × @item.Quantity</span><strong>$@item.LineTotal.ToString("N2")</strong></div> }<hr /><div><span>Subtotal</span><span>$@Model.Quote.Subtotal.ToString("N2")</span></div><div><span>Discount</span><span>-$@Model.Quote.Discount.ToString("N2")</span></div><div><span>Delivery</span><span>$@Model.Quote.Delivery.ToString("N2")</span></div><div class="field coupon-field"><label>Coupon</label><input asp-for="CouponCode" /></div><hr /><div class="total"><span>Total</span><strong>$@Model.Quote.Total.ToString("N2")</strong></div><div class="cod-note"><strong>Cash on delivery</strong><p>Have the exact amount ready when your order arrives.</p></div><button class="button button-dark" type="submit">Place order</button></aside></div></form></section>
