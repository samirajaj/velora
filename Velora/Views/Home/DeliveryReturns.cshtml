@{ ViewData["Title"] = "Delivery & Returns"; }
<section class="account-page shell-narrow"><div class="account-card care-page"><p class="eyebrow">Client care</p><h1>Delivery & returns</h1><h2>Delivery</h2><p>Delivery is complimentary for orders over $200. The final delivery charge and order total are calculated securely during checkout.</p><h2>Cash on delivery</h2><p>Payment is collected when your order arrives. Our team will contact you before dispatch.</p><h2>Returns</h2><p>Contact us within 30 days of delivery with your order number. Items must be unworn, unused, and returned with their original tags and packaging.</p><a class="button button-dark" asp-action="Contact">Contact client care</a></div></section>
