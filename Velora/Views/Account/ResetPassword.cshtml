@model Velora.Features.Accounts.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; }
<section class="account-page shell-narrow"><div class="account-card"><p class="eyebrow">Account security</p><h1>Choose a new password</h1><form method="post"><input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /></div><div class="field"><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" autocomplete="new-password" /></div><button class="button button-dark" type="submit">Reset password</button></form></div></section>
