@model Velora.Features.Accounts.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot Password"; }
<section class="account-page shell-narrow"><div class="account-card"><p class="eyebrow">Account assistance</p><h1>Reset password</h1><p class="account-intro">Enter your account email and we will send a secure reset link.</p><form method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div><button class="button button-dark" type="submit">Send reset link</button></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
