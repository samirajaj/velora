@model Velora.Features.Accounts.LoginViewModel
@{ ViewData["Title"] = "Sign In"; }
<section class="account-page shell-narrow"><div class="account-card"><p class="eyebrow">Welcome back</p><h1>Sign in</h1><p class="account-intro">Continue your Velora experience.</p><form method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password"></span></div><label class="check-field"><input asp-for="RememberMe" /> Remember me</label><button class="button button-dark" type="submit">Sign in</button></form><p class="account-switch"><a asp-action="ForgotPassword">Forgot password?</a></p><p class="account-switch">New to Velora? <a asp-action="Register">Create an account</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
