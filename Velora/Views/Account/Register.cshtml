@model Velora.Features.Accounts.RegisterViewModel
@{ ViewData["Title"] = "Create Account"; }
<section class="account-page shell-narrow"><div class="account-card"><p class="eyebrow">Welcome to Velora</p><h1>Create an account</h1><p class="account-intro">Save your details and enjoy a more considered shopping experience.</p><form method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-row"><div class="field"><label asp-for="FirstName"></label><input asp-for="FirstName" autocomplete="given-name" /><span asp-validation-for="FirstName"></span></div><div class="field"><label asp-for="LastName"></label><input asp-for="LastName" autocomplete="family-name" /><span asp-validation-for="LastName"></span></div></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span></div><div class="field"><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div><button class="button button-dark" type="submit">Create account</button></form><p class="account-switch">Already registered? <a asp-action="Login">Sign in</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
