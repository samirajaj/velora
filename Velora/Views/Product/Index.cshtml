@model Velora.Application.Catalog.CatalogResult
@{ ViewData["Title"] = "The Collection"; var category = ViewData["Category"] as string; var search = ViewData["Search"] as string; var sort = ViewData["Sort"] as string ?? "featured"; var color = ViewData["Color"] as string; var size = ViewData["Size"] as string; var inStock = ViewData["InStockOnly"] as bool? ?? false; }
<header class="page-hero shell"><p class="eyebrow">Velora collection</p><h1>@(string.IsNullOrWhiteSpace(search) ? "The collection" : $"Results for “{search}”")</h1><p>Considered silhouettes for an expressive, enduring wardrobe.</p></header>
<section class="catalog shell"><div class="catalog-toolbar"><div class="category-filters"><a class="@(string.IsNullOrEmpty(category) ? "active" : "")" asp-action="Index">All</a>@foreach (var item in Model.Categories) { <a class="@(category == item.Slug ? "active" : "")" asp-action="Index" asp-route-category="@item.Slug">@item.Name</a> }</div><button class="filter-toggle" type="button" data-filter-toggle>Filters</button></div>
<form class="catalog-filters" method="get" data-filter-panel>@if (!string.IsNullOrWhiteSpace(category)) { <input type="hidden" name="category" value="@category" /> } @if (!string.IsNullOrWhiteSpace(search)) { <input type="hidden" name="search" value="@search" /> }<label>Min price<input type="number" name="minPrice" min="0" step="1" value="@ViewData["MinPrice"]" /></label><label>Max price<input type="number" name="maxPrice" min="0" step="1" value="@ViewData["MaxPrice"]" /></label><label>Color<select name="color"><option value="">All colors</option>@foreach (var option in Model.AvailableColors) { <option value="@option" selected="@(color == option)">@option</option> }</select></label><label>Size<select name="size"><option value="">All sizes</option>@foreach (var option in Model.AvailableSizes) { <option value="@option" selected="@(size == option)">@option</option> }</select></label><label>Sort<select name="sort"><option value="featured" selected="@(sort == "featured")">Featured</option><option value="newest" selected="@(sort == "newest")">Newest</option><option value="price-asc" selected="@(sort == "price-asc")">Price, low to high</option><option value="price-desc" selected="@(sort == "price-desc")">Price, high to low</option></select></label><label class="check-field"><input type="checkbox" name="inStockOnly" value="true" checked="@inStock" /> In stock</label><button class="button button-dark" type="submit">Apply filters</button></form>
<p class="result-count">@Model.TotalItems @(Model.TotalItems == 1 ? "piece" : "pieces")</p>@if (Model.Items.Count == 0) { <div class="empty-state"><h2>No pieces found</h2><p>Try another search or explore the complete collection.</p><a class="button button-dark" asp-action="Index">Shop all</a></div> } else { <div class="product-grid catalog-grid">@foreach (var product in Model.Items) { <partial name="_ProductCard" model="product" /> }</div> }@if (Model.TotalPages > 1) { <nav class="pagination" aria-label="Catalog pages">@for (var i = 1; i <= Model.TotalPages; i++) { <a class="@(i == Model.Page ? "active" : "")" asp-route-page="@i" asp-route-category="@category" asp-route-search="@search" asp-route-sort="@sort" asp-route-color="@color" asp-route-size="@size" asp-route-inStockOnly="@inStock">@i</a> }</nav> }</section>
