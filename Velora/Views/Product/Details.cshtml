@model Velora.Application.Catalog.ProductDetails
@{ ViewData["Title"] = Model.Name; ViewData["Description"] = Model.Description; }
<section class="product-detail shell">
    <div class="detail-image"><img src="@Model.ImageUrl" alt="@Model.Name" /></div>
    <div class="detail-content"><p class="breadcrumbs"><a asp-action="Index">Collection</a> / <a asp-action="Index" asp-route-category="@Model.CategorySlug">@Model.CategoryName</a></p><p class="eyebrow">@Model.CategoryName</p><h1>@Model.Name</h1><p class="detail-price">$@Model.Price.ToString("N0") @if (Model.CompareAtPrice is not null) { <del>$@Model.CompareAtPrice.Value.ToString("N0")</del> }</p><p class="detail-description">@Model.Description</p>
        <form class="add-form" asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="slug" value="@Model.Slug" /><label for="variant">Select an option</label><select id="variant" name="variantId" required><option value="" disabled selected>Choose size</option>@foreach (var option in Model.Options) { <option value="@option.Id" disabled="@(option.StockQuantity <= 0)">@option.Color · @option.Size @(option.StockQuantity <= 0 ? "— Sold out" : "")</option> }</select><div class="quantity-row"><label for="quantity">Quantity</label><input id="quantity" name="quantity" type="number" min="1" max="10" value="1" /></div><button class="button button-dark" type="submit">Add to bag</button></form>
        <div class="detail-notes"><details open><summary>Details & care</summary><p>Designed for a timeless wardrobe. Store with care and follow the instructions on the garment label.</p></details><details><summary>Delivery & returns</summary><p>Complimentary delivery over $200. Returns are accepted within 30 days.</p></details></div>
    </div>
</section>
