@model Velora.Application.Customers.CustomerAddress
@{ ViewData["Title"] = Model.Id.HasValue ? "Edit Address" : "New Address"; }
<section class="account-page shell-narrow"><div class="account-card"><p class="eyebrow">My account</p><h1>@ViewData["Title"]</h1><form asp-action="SaveAddress" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-row"><div class="field"><label asp-for="Label"></label><input asp-for="Label" /></div><div class="field"><label asp-for="RecipientName">Recipient</label><input asp-for="RecipientName" /></div></div><div class="field"><label asp-for="PhoneNumber">Phone</label><input asp-for="PhoneNumber" /></div><div class="field"><label asp-for="Line1">Address line 1</label><input asp-for="Line1" /></div><div class="field"><label asp-for="Line2">Address line 2</label><input asp-for="Line2" /></div><div class="form-row"><div class="field"><label asp-for="City"></label><input asp-for="City" /></div><div class="field"><label asp-for="StateOrProvince">Province</label><input asp-for="StateOrProvince" /></div></div><div class="form-row"><div class="field"><label asp-for="PostalCode">Postal code</label><input asp-for="PostalCode" /></div><div class="field"><label asp-for="CountryCode">Country code</label><input asp-for="CountryCode" maxlength="2" /></div></div><label class="check-field"><input asp-for="IsDefault" /> Default address</label><button class="button button-dark">Save address</button></form></div></section>
