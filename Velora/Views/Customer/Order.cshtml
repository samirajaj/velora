@model Velora.Application.Commerce.OrderDetailsModel
@{ ViewData["Title"] = $"Order {Model.Number}"; }
<section class="cart-page shell"><header><p class="eyebrow">Order history</p><h1>@Model.Number</h1><p>@Model.Status · @Model.CreatedAtUtc.ToString("dd MMMM yyyy")</p></header><div class="cart-layout"><div class="cart-items">@foreach (var item in Model.Items) { <article class="cart-item"><img src="@item.ImageUrl" alt="@item.ProductName" /><div class="cart-item-info"><h2>@item.ProductName</h2><p>@item.Option · @item.Sku</p><p>Quantity @item.Quantity</p></div><div class="cart-line"><strong>$@item.LineTotal.ToString("N2")</strong></div></article> }</div><aside class="cart-summary"><h2>Summary</h2><div><span>Subtotal</span><span>$@Model.Subtotal.ToString("N2")</span></div><div><span>Discount</span><span>-$@Model.Discount.ToString("N2")</span></div><div><span>Delivery</span><span>$@Model.Delivery.ToString("N2")</span></div><hr /><div class="total"><span>Total</span><strong>$@Model.Total.ToString("N2")</strong></div><p>Payment: @Model.PaymentStatus</p><p>Deliver to: @Model.Address</p></aside></div></section>
