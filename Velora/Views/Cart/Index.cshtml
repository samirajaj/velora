@model Velora.Features.Cart.CartViewModel
@{ ViewData["Title"] = "Your Bag"; }
<section class="cart-page shell"><header><p class="eyebrow">Your selection</p><h1>Shopping bag</h1><p>@Model.ItemCount @(Model.ItemCount == 1 ? "item" : "items")</p></header>@if (TempData["CartMessage"] is string message) { <div class="cart-notice" role="status">@message</div> }
@if (Model.Items.Count == 0) { <div class="empty-state"><h2>Your bag is waiting</h2><p>Discover considered pieces made to stay with you.</p><a class="button button-dark" asp-controller="Product" asp-action="Index">Explore the collection</a></div> } else { <div class="cart-layout"><div class="cart-items">@foreach (var item in Model.Items) { <article class="cart-item"><a asp-controller="Product" asp-action="Details" asp-route-slug="@item.Slug"><img src="@item.ImageUrl" alt="@item.Name" /></a><div class="cart-item-info"><h2><a asp-controller="Product" asp-action="Details" asp-route-slug="@item.Slug">@item.Name</a></h2><p>@item.Option</p><p>$@item.UnitPrice.ToString("N0")</p><form asp-action="Update" method="post"><input type="hidden" name="variantId" value="@item.VariantId" /><label>Qty <input type="number" name="quantity" min="0" max="10" value="@item.Quantity" onchange="this.form.submit()" /></label></form></div><div class="cart-line"><strong>$@item.LineTotal.ToString("N0")</strong><form asp-action="Remove" method="post"><input type="hidden" name="variantId" value="@item.VariantId" /><button type="submit">Remove</button></form></div></article> }</div><aside class="cart-summary"><h2>Order summary</h2><div><span>Subtotal</span><strong>$@Model.Subtotal.ToString("N0")</strong></div><div><span>Delivery</span><span>@(Model.Subtotal >= 200 ? "Complimentary" : "Calculated at checkout")</span></div><hr /><div class="total"><span>Total</span><strong>$@Model.Subtotal.ToString("N0")</strong></div><button class="button button-dark" type="button">Continue to checkout</button><small>Taxes calculated at checkout.</small></aside></div> }
</section>
